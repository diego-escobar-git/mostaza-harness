# Local settings only; these are never included in submission.zip.
MOSTAZA_MODEL=google/gemma-4-12b
MOSTAZA_API_BASE=http://127.0.0.1:1234/v1
# Optional: the real local token when LM Studio authentication is enabled.
# MOSTAZA_API_KEY=
# Optional: reuse an installed official environment without reinstalling it.
# Quote paths with spaces; this file is also sourced by the shell entrypoints.
# MOSTAZA_PYTHON='/absolute/path/to/existing/bin/python'
# Directory containing the official tasks.jsonl and snapshots/.
MOSTAZA_DATA_DIR=resources/official
